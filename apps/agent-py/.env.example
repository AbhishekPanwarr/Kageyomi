# FastAPI Server
HOST=127.0.0.1
PORT=8000

# UAVP Agent
KAGEYOMI_MAX_TOOLS=5
KAGEYOMI_CANONICALIZATION_STRICT=true
KAGEYOMI_USE_MOCK_SOSO=false

# SoSoValue API
SOSOVALUE_API_KEY=
SOSO_BASE_URL=https://openapi.sosovalue.com/openapi/v1
SOSO_REQUESTS_PER_MINUTE=10

# IPFS
IPFS_GATEWAY=https://gateway.lighthouse.storage
LIGHTHOUSE_API_KEY=

# Fhenix / Arbitrum
FHENIX_RPC_URL=
FHENIX_PRIVATE_KEY=
KAGEYOMI_EXTENSION_CONTRACT_ADDRESS=
