{
  "name": "@kageyomi/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "dry-run": "node --import tsx src/agent/groq-agent.ts",
    "smoke:live": "node --import tsx src/agent/groq-agent.ts",
    "dev": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "groq-sdk": "^0.16.0",
    "js-sha256": "^0.11.1",
    "viem": "^2.28.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1"
  }
}
